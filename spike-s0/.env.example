# === Vertex — kênh voice Live (KHÁC AI Studio GEMINI_API_KEY của engine cũ) ===
GOOGLE_CLOUD_PROJECT=<your-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
# ADC: đường dẫn tới service-account key. Chạy `npm run` từ trong spike-s0/ nên đường tương đối này trỏ về gốc repo.
GOOGLE_APPLICATION_CREDENTIALS=../recall-live-proxy-key.json

# Model Live native-audio. Đổi tại đây nếu id trên Vertex khác lúc chạy spike 11/08.
LIVE_MODEL=gemini-live-2.5-flash-native-audio

# === p4 auth ===
P4_SESSIONS=3
P4_SESSION_MS=300000        # 5 phút/phiên theo giao thức. Smoke nhanh: đặt 30000.

# === p1 latency ===
# WAV 16kHz mono PCM. Tự sinh bằng TTS Vertex: `npm run gen:wav` (khỏi cần ghi âm).
P1_AUDIO_WAV=./fixtures/student-vi-16k.wav
P1_ITERATIONS=25

# TTS cho gen:wav (mặc định đủ dùng). Nội dung câu không ảnh hưởng phép đo latency.
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
# P1_TTS_TEXT="..."   # câu tiếng Việt tùy chọn
