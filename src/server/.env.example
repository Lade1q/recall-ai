# Port for local backend server
PORT=3001

# Application environment
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/recall_ai_dev?schema=public"

# JWT Secret Keys (Must be at least 32 characters long)
JWT_SECRET="your_jwt_secret_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Google Gemini AI API Key
GEMINI_API_KEY="insert_your_actual_gemini_api_key_here"

# Skip real Gemini calls and use fixed sample data (dev/test, avoids quota usage)
USE_MOCK_AI=false

# Model used for the extract_concepts call (I3.2)
# Use the rolling "-latest" alias, not a pinned dated name — Google retires
# dated model IDs for new API keys with little notice (confirmed 2026-07-25:
# gemini-2.5-flash and gemini-2.5-flash-lite both returned HTTP 404 "no
# longer available to new users" on a fresh free-tier key).
GEMINI_MODEL_EXTRACT="gemini-flash-latest"
