# Port for local backend server
PORT=3001

# Application environment
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/recall_ai_dev?schema=public"

# JWT Secret Keys (Must be at least 32 characters long)
JWT_SECRET="your_jwt_secret_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Google Gemini AI API Key
GEMINI_API_KEY="insert_your_actual_gemini_api_key_here"

# Skip real Gemini calls and use fixed sample data (dev/test, avoids quota usage)
USE_MOCK_AI=false

# Model used for the extract_concepts call (I3.2)
# Use the rolling "-latest" alias, not a pinned dated name — Google retires
# dated model IDs for new API keys with little notice (confirmed 2026-07-25:
# gemini-2.5-flash and gemini-2.5-flash-lite both returned HTTP 404 "no
# longer available to new users" on a fresh free-tier key).
GEMINI_MODEL_EXTRACT="gemini-flash-latest"

# Model used for the generate_question / grade_answer calls (I6.2)
# Same "-latest" rule as above. These two run inside a live conversation, so latency
# matters more than depth — see GEMINI_THINKING_INTERVIEW below.
GEMINI_MODEL_INTERVIEW="gemini-flash-latest"

# Upper bound (ms) on any single Gemini SDK call (files.get/upload, interactions.create).
# A hang past this becomes an AI_UNAVAILABLE error, which the existing AE-02 retry and
# AE-05 flashcard fallback already handle. Default has margin above the ~10-20s grading
# latency observed in production.
GEMINI_TIMEOUT_MS=30000

# --- Reasoning depth per AI call (thinking_level) ---------------------------
# Accepted values: minimal | low | medium | high. Anything else is REJECTED at
# startup-time parsing (a warning is logged and the default below is used).
#
# Why validated instead of passed straight through: the SDK types this field as
# `'minimal' | 'low' | 'medium' | 'high' | (string & {})`, so a typo compiles
# fine and only surfaces as an HTTP 400 on EVERY AI call at runtime.

# Phase 1 of plan analysis — extract_concepts, one call per uploaded document.
# Reads the document directly, so depth buys little; latency is what the upload
# screen shows the user.
GEMINI_THINKING_EXTRACT=low

# Phase 2 of plan analysis — link_topics, one call that orders the documents.
# Works on derived text (concept names + verbatim excerpts) rather than the
# documents themselves, and the input is small, so it can afford more depth.
GEMINI_THINKING_LINK=medium

# generate_question / grade_answer. These run inside a live conversation, so
# latency matters more than depth.
GEMINI_THINKING_INTERVIEW=low
