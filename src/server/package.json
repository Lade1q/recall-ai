{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --files src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:seed": "ts-node -O '{\"rootDir\":\".\",\"module\":\"commonjs\"}' prisma/seed-test.ts",
    "test:auth": "postman collection run \"../../postman/dist/Authentication Module Tests.collection.json\" -e \"../../postman/environments/Local Dev.environment.yaml\"",
    "test:setup": "ts-node -O '{\"rootDir\":\".\",\"module\":\"commonjs\"}' test-setup.ts",
    "test:planner": "npm run test:setup && cd \"../../postman/test-data/TC-SP-Studyplanner\" && postman collection run \"../../collections/Study Planner Tests\" -e \"../../environments/Local Dev.environment.yaml\"",
    "test:run": "npm run test:seed && npm run test:auth && npm run test:planner"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "ts-node -O '{\"rootDir\":\".\",\"module\":\"commonjs\"}' prisma/seed.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.64.0"
  },
  "allowScripts": {
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  }
}
